{
	"schemaVersion": 1,
	"id": "restockitem",
	"version": "${version}",
	"name": "RestockItem & AutoTool",
	"description": "Automatically refills your active hotbar/off-hand slot from your inventory when a stack runs out, and switches to the best tool when you start breaking a block.",
	"authors": [
		"Mosuzzzz"
	],
	"contact": {
		"sources": "https://github.com/Mosuzzzz/restockitem"
	},
	"license": "CC0-1.0",
	"icon": "assets/restockitem/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"restock.modid.RestockItem"
		],
		"client": [
			"restock.modid.client.RestockItemClient"
		],
		"fabric-datagen": [
			"restock.modid.client.RestockItemDataGenerator"
		]
	},
	"mixins": [
		"restockitem.mixins.json",
		{
			"config": "restockitem.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=26",
		"fabric-api": "*"
	}
}